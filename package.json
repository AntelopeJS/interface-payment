{
  "name": "@antelopejs/interface-payment",
  "version": "0.1.0",
  "description": "Provider-agnostic AntelopeJS payment interface: hosted checkout, direct payments with auth/capture, refunds, saved payment methods, and normalised webhook events",
  "keywords": [
    "antelopejs",
    "checkout",
    "interface",
    "payment",
    "refund",
    "webhook"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/interface-payment.git"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tests/*": {
      "types": "./dist/tests/*.d.ts",
      "default": "./dist/tests/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "pnpm build && ajs module test .",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run prepack && release-it",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@antelopejs/interface-core": ">=0.0.3 <1.0.0",
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.0.3 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "test": "src/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
